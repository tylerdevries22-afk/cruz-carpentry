# Supabase — Cruz Carpentry
# Copy this file to `.env.local` and fill in real values from your project's
# dashboard (Project Settings -> API). `.env.local` is gitignored.

# Project API URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key (safe to expose to the browser). Used for public
# reads of the published gallery. Accepts a legacy anon JWT or an
# `sb_publishable_...` key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret service-role key (server-only — NEVER prefix with NEXT_PUBLIC).
# Used by the estimate-request Server Action to insert leads, bypassing RLS.
# Accepts a legacy service_role JWT or an `sb_secret_...` key.
SUPABASE_SERVICE_ROLE_KEY=
