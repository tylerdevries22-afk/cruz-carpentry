# Supabase — Cruz Carpentry
# Copy this file to `.env.local` and fill in real values from your project's
# dashboard (Project Settings -> API). `.env.local` is gitignored.

# Canonical production origin (no trailing slash). Drives every canonical tag,
# the sitemap, OpenGraph URLs, and JSON-LD. Set in Vercel (Production) to the
# live custom domain; falls back to the Vercel URL when unset.
NEXT_PUBLIC_SITE_URL=https://www.customcarpentrycolorado.com

# Project API URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key (safe to expose to the browser). Used only by
# scripts/verify-supabase.mjs to confirm RLS blocks anon reads of leads; the
# app itself doesn't read it (the gallery is local). Accepts a legacy anon JWT
# or an `sb_publishable_...` key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret service-role key (server-only — NEVER prefix with NEXT_PUBLIC).
# Used by the estimate-request Server Action to insert leads, bypassing RLS.
# Accepts a legacy service_role JWT or an `sb_secret_...` key.
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard (/admin) — set BOTH to enable the internal lead dashboard.
# Leave unset to keep /admin disabled (fails closed). Set in Vercel (Production)
# to activate. ADMIN_PASSWORD: login password (>=8 chars). ADMIN_SESSION_SECRET:
# random >=16 chars to sign the session cookie (e.g. `openssl rand -hex 32`).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional database connection string (Supabase -> Project Settings -> Database)
# used only to apply SQL migrations with psql; not read by the app at runtime.
DATABASE_URL=

# Secret for the Vercel Cron that cleans up orphaned photo uploads. Vercel sends
# `Authorization: Bearer $CRON_SECRET` to /api/cron/* — set the same value here
# and in Vercel. Random string, e.g. `openssl rand -hex 24`.
CRON_SECRET=
